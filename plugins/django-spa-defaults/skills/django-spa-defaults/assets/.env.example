# Copy to .env and adjust. Native development reads it directly (backend/config/settings.py);
# docker compose passes it into the app container and overrides a few values (see below).
# On a server, compose.yml and this .env are all that is needed. After an update of the
# repository, `python scripts/sync_env.py` adds new variables to an existing .env.

# --- Application ----------------------------------------------------------------
# Every URL users open <Project> under, comma separated (scheme, host and port if not
# default). Allowed hosts, CSRF trusted origins and secure cookies are derived from it;
# use https URLs only once a TLS proxy is in front.
APP_URLS=http://localhost:8080
# Host port compose publishes the app on. Default: 8080.
# APP_BIND=8080
# Image to run; default ghcr.io/<owner>/<project>:latest. Pin a version for production,
# e.g. ghcr.io/<owner>/<project>:1.2
# APP_IMAGE=

# Address(es) of a TLS proxy in front of <Project> (comma separated IPs or CIDR ranges).
# Only from these nginx accepts X-Forwarded-For/-Proto, i.e. the client's address and
# HTTPS. Required with https URLs in APP_URLS. Empty: clients connect directly.
TRUSTED_PROXIES=

# Long random string (at least 40 characters; <Project> refuses to start otherwise), e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# With DEBUG=true a fixed development key is used while this is still the placeholder.
SECRET_KEY=change-me
# true for native development (runserver, Vite). docker compose always sets false.
DEBUG=true
TIME_ZONE=<TIMEZONE>
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First administrator (created on first start if the user does not exist) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=it@example.com
# Only used when the user is created; change it later with
#   docker compose exec app python manage.py set_password admin
ADMIN_PASSWORD=change-me

# --------------------------------------------------------------------------- database
# Without DB_HOST (native development, local tests) the app uses a SQLite file in
# DATA_DIR and runs background jobs in-process; there is no job worker. With DB_HOST it
# uses PostgreSQL with the values below: docker compose sets DB_HOST=db (and DEBUG=false)
# inside the app container. To run natively against PostgreSQL like CI does, start the
# `just db-up` (compose.dev.yml) and set DB_HOST=localhost.
DB_NAME=<project>
DB_USER=<project>
# Production: a long random value, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# --------------------------------------------------------------------------- backups
# The worker container dumps the database every night at BACKUP_TIME (in TIME_ZONE) into
# BACKUP_DIR and deletes dumps older than BACKUP_KEEP_DAYS days. The image sets
# BACKUP_DIR=/backups (the "backups" volume); empty switches the nightly dump off.
# Manual dump: docker compose exec worker python manage.py backup_database
# Avoid 02:00-03:00: daylight saving time skips that hour once a year and repeats it once.
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=

# --------------------------------------------------------------------------- server
# Gunicorn worker processes in the app container; each handles one request at a time
# and needs roughly 50-150 MB RAM. Rule of thumb: 2 x CPU cores + 1. Default: 3.
# GUNICORN_WORKERS=3
# Jobs the worker container runs at the same time. Default: 4.
# WORKER_CONCURRENCY=4
# Writable data directory (uploads etc.). Natively backend/data; the container uses
# its /data volume.
# DATA_DIR=
