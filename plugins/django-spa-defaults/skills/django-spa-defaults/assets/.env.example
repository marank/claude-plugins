# Copy to .env next to compose.yml and set the values marked REQUIRED; then `docker compose up -d`.
# Every setting is listed here: after an update, compare your .env with this file.

# --- Application ----------------------------------------------------------------
# REQUIRED. Every address users open <Project> under, comma separated, e.g.
# https://app.example.com. Use https only when a TLS proxy is in front.
APP_URLS=http://localhost:8080
# Port the app is published on; also host:port, e.g. 127.0.0.1:8080. Default: 8080.
# APP_BIND=8080
# The app image. Pin a version to update on purpose, e.g. ghcr.io/<owner>/<project>:1.2
# APP_IMAGE=

# The reverse proxy in front (IPs or CIDR ranges, comma separated). Required with https URLs.
# Empty or "none": clients connect directly. A range that covers every address is refused.
TRUSTED_PROXIES=

# REQUIRED. A long random string, at least 40 characters, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
TIME_ZONE=<TIMEZONE>
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Django admin ------------------------------------------------------------------
# The Django admin at /django-admin, for staff users. Off unless someone needs it.
ADMIN_ENABLED=false

# --- First administrator (created on start if the user does not exist) ------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Only used when the user is created, exactly as written here. Change it later with
#   docker compose exec app python manage.py set_password admin
ADMIN_PASSWORD=administrator

# --- Database (PostgreSQL, started by compose) -------------------------------------
DB_NAME=<project>
DB_USER=<project>
# REQUIRED. A long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=change-me

# --- Backups -----------------------------------------------------------------------
# Every night at BACKUP_TIME (in TIME_ZONE): the database and the uploaded files go into the
# "backups" volume; backups older than BACKUP_KEEP_DAYS days are deleted.
# Avoid 02:00-03:00: the clock change skips or repeats that hour.
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=14
# [BACKUP_JOB]
# Set empty to switch the nightly backup off.
# BACKUP_DIR=
# [/BACKUP_JOB]

# --- Server ------------------------------------------------------------------------
# [WSGI]
# Web processes in the app container, one request at a time each, 50-150 MB RAM each.
# Rule of thumb: 2 x CPU cores + 1. Default: 3.
# GUNICORN_WORKERS=3
# [/WSGI]
# [ASGI]
# Web processes in the app container (uvicorn). Default: 3.
# WEB_WORKERS=3
# [/ASGI]
# Jobs the worker runs at the same time. Default: 4.
# WORKER_CONCURRENCY=4

# --- For developers: running without Docker ----------------------------------------
# DEBUG is off unless set; the `just` development recipes turn it on themselves.
# Without DB_HOST the app uses SQLite in DATA_DIR and runs jobs in-process. For PostgreSQL
# start `just db-up` and set DB_HOST=localhost.
# DB_HOST=localhost
# DB_PORT=5432
# Writable data (uploads etc.), natively backend/data.
# DATA_DIR=
# `python scripts/sync_env.py` adds new settings to an existing .env.
