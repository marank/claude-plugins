# Rendered by start-nginx (envsubst); only the three ${…} placeholders are replaced.

# Is the direct peer one of TRUSTED_PROXIES?
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
${TRUSTED_GEO}
}

# Client scheme: X-Forwarded-Proto only from trusted proxies, else the connection's own.
map "$from_trusted_proxy:$http_x_forwarded_proto" $client_proto {
    "~^1:(?<fwd>https?)$" $fwd;
    default $scheme;
}

# [ASGI]
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}
# [/ASGI]

server {
    listen 8080;
    client_max_body_size 25m;
${REAL_IP_CONFIG}

    root /srv/spa;

    location /api/ {
        include /etc/nginx/django_proxy.conf;
    }

    # Brute-force brake: per client IP (after TRUSTED_PROXIES evaluation), see nginx.conf.
    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        include /etc/nginx/django_proxy.conf;
    }

    location ~ ^/django-admin(/|$) {
        include /etc/nginx/django_proxy.conf;
    }

    # [ASGI] WebSockets (the path is the project's choice); longer than the app's heartbeat.
    location /ws/ {
        include /etc/nginx/django_proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
    # [/ASGI]

    # Locations of the project (kept outside the template comparison, DOCKER-12).
    # --- project: locations ---
    # --- end ---

    location /django-static/ {
        alias /app/staticfiles/;
        expires 7d;
        access_log off;
        include /etc/nginx/security_headers.conf;
    }

    # Vite's hashed build output
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security_headers.conf;
        try_files $uri =404;
    }

    # [DOCS] Documentation (VitePress, built with base /docs/ and clean URLs).
    location = /docs {
        return 301 /docs/;
    }
    location /docs/assets/ {
        alias /srv/docs/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security_headers.conf;
    }
    location /docs/ {
        alias /srv/docs/;
        try_files $uri $uri.html $uri/index.html =404;
        error_page 404 /docs/404.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security_headers.conf;
    }

    # SPA: unknown paths fall back to index.html, which must never be cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security_headers.conf;
    }
}
