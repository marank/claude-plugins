# The project's commands — the one place they live. CI (.github/workflows/build.yaml) and the
# VS Code tasks (.vscode/tasks.json) call these recipes, so a check is changed here and
# nowhere else. `just` lists them. Needs just >= 1.38 (working-directory attribute).

set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# List the recipes
default:
    @just --list

# --- Setup --------------------------------------------------------------------------

# Install all dependencies
setup: setup-backend setup-frontend setup-docs

[working-directory: 'backend']
setup-backend:
    uv sync

[working-directory: 'frontend']
setup-frontend:
    pnpm install

# [DOCS]
[working-directory: 'docs']
setup-docs:
    pnpm install

# --- Development ----------------------------------------------------------------------

# Django on :8000 (SQLite in backend/data, no job worker)
[working-directory: 'backend']
dev-backend:
    uv run python manage.py runserver

# Vite on :<DEV_PORT>, proxying /api, /django-admin and /django-static to Django
[working-directory: 'frontend']
dev-frontend:
    pnpm dev

# [DOCS] VitePress dev server
[working-directory: 'docs']
dev-docs:
    pnpm dev

# Optional PostgreSQL like CI (compose.dev.yml); then DB_HOST=localhost in .env
db-up:
    docker compose -f compose.dev.yml up -d

# Apply migrations and create the first admin
[working-directory: 'backend']
migrate:
    uv run python manage.py migrate
    uv run python manage.py ensure_admin

# After model changes; commit the migrations
[working-directory: 'backend']
migrations:
    uv run python manage.py makemigrations

# After API changes: schema -> frontend/openapi.json -> src/api/schema.d.ts; commit both
[working-directory: 'frontend']
api-types: api-schema
    pnpm api:types

[working-directory: 'backend']
api-schema:
    <OPENAPI_EXPORT_COMMAND>

# [BACKEND_DE] After new backend texts; then translate backend/locale/de/LC_MESSAGES/django.po
[working-directory: 'backend']
messages:
    uv run python manage.py makemessages -l de --ignore=.venv

# [BACKEND_DE]
[working-directory: 'backend']
compile-messages:
    uv run python manage.py compilemessages --ignore=.venv

# --- Checks (= CI) --------------------------------------------------------------------

# Everything CI checks; must pass before a push
check: check-backend check-deploy check-frontend check-docs check-workflows

# ruff, mypy, deptry, import layers, licenses, migrations, Django checks, translations, OpenAPI, tests
[working-directory: 'backend']
check-backend:
    uv sync --locked
    uv run ruff check --output-format=concise .
    uv run ruff format --check .
    uv run mypy .
    uv run deptry .
    uv run lint-imports
    uv run python scripts/check_licenses.py
    uv run python manage.py makemigrations --check --dry-run
    uv run python manage.py check --fail-level WARNING
    # [BACKEND_DE] the next three lines
    uv run python manage.py makemessages -l de --ignore=.venv
    uv run --with polib python scripts/check_translations.py
    uv run python manage.py compilemessages --ignore=.venv
    uv run python scripts/check_openapi.py
    uv run pytest -q --cov

# Django's deploy checks with production-like settings (deploy-check.env)
[working-directory: 'backend']
check-deploy:
    uv run --env-file deploy-check.env python manage.py check --deploy --fail-level WARNING

# prettier, oxlint, eslint, knip, types, tests, API types, build, bundle size, licenses
[working-directory: 'frontend']
check-frontend:
    pnpm install --frozen-lockfile
    pnpm check
    pnpm api:types
    git diff --exit-code -- src/api/schema.d.ts
    pnpm build-only
    pnpm size
    pnpm check:licenses

# [DOCS] VitePress build: dead links, anchors, missing translations
[working-directory: 'docs']
check-docs:
    pnpm install --frozen-lockfile
    pnpm build

# GitHub workflows: syntax (actionlint) and security (zizmor)
check-workflows:
    uvx --from actionlint-py==<ACTIONLINT> actionlint
    uvx zizmor@<ZIZMOR> .github/

# --- Docker ----------------------------------------------------------------------------

# Build the image locally and start the production-like stack (http://127.0.0.1:8080)
docker-up $APP_IMAGE="<project>":
    docker build -t <project> .
    docker compose up -d

# Dump the database now (the worker does it nightly)
docker-backup:
    docker compose exec worker python manage.py backup_database

docker-logs:
    docker compose logs -f app worker

docker-down:
    docker compose down
